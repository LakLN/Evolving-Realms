{
  "pack_version": 1,
  "definitions": [
    {"content_id":"core:event/ruin_cache","version":1,"schema_version":1,"kind":"world_event","name":"Collapsed storeroom","description":"Rubble hides what the old keepers stored.","metadata":{"category":"reward"},
     "dependencies":[{"content_id":"core:coin","version":1},{"content_id":"core:iron_sword","version":1},{"content_id":"core:book/stone_throw","version":1}],
     "payload":{"tone":"boon","message":"You dig through the rubble of a storeroom.","outcomes":[
       {"type":"loot","table":{"guaranteed":[{"content_id":"core:coin","version":1,"min":3,"max":8}],"rolls":1,"entries":[
         {"content_id":"core:iron_sword","version":1,"min":1,"max":1,"weight":1},{"content_id":"core:book/stone_throw","version":1,"min":1,"max":1,"weight":2},{"content_id":"core:coin","version":1,"min":4,"max":6,"weight":3}]}},
       {"type":"xp","amount":15}]}},
    {"content_id":"core:event/ruin_inscription","version":1,"schema_version":1,"kind":"world_event","name":"Keeper's inscription","description":"Worn script that only a trained or gifted eye can read.","metadata":{"category":"legacy"},
     "dependencies":[{"content_id":"core:book/body_tempering","version":1},{"content_id":"core:talent/spirit_eye","version":1}],
     "payload":{"tone":"boon","message":"The inscription is a body-tempering method left to whoever could read it.",
       "conditions":[{"type":"any_of","conditions":[{"type":"level","min":2},{"type":"talent","values":["core:talent/spirit_eye"]}]}],
       "outcomes":[{"type":"grant_items","items":[{"content_id":"core:book/body_tempering","version":1,"quantity":1}]},{"type":"xp","amount":40}]}},
    {"content_id":"core:event/shrine_offering","version":1,"schema_version":1,"kind":"world_event","name":"Offering at the shrine","description":"A herb laid on the stone brings quiet warmth.","metadata":{"category":"blessing"},
     "dependencies":[{"content_id":"core:herb","version":1},{"content_id":"core:status/regeneration","version":1}],
     "payload":{"tone":"boon","message":"The shrine accepts the herb. Warmth runs through you.","cost":{"items":[{"content_id":"core:herb","version":1,"quantity":1}]},
       "outcomes":[{"type":"heal","amount":15},{"type":"cleanse","harmful":true},{"type":"apply_status","content_id":"core:status/regeneration","version":1}]}},
    {"content_id":"core:event/shrine_plunder","version":1,"schema_version":1,"kind":"world_event","name":"Plundered shrine","description":"Coins lie under the altar, and the shrine does not forgive.","metadata":{"category":"curse"},
     "dependencies":[{"content_id":"core:coin","version":1},{"content_id":"core:status/bleed","version":1}],
     "payload":{"tone":"bane","message":"You pry the coins loose. A cold wound opens on your hand.",
       "outcomes":[{"type":"grant_items","items":[{"content_id":"core:coin","version":1,"quantity":12}]},{"type":"apply_status","content_id":"core:status/bleed","version":1}]}},
    {"content_id":"core:event/spirit_vein","version":1,"schema_version":1,"kind":"world_event","name":"Spirit vein","description":"Raw energy seeps from a crack in the earth.","metadata":{"category":"opportunity"},
     "dependencies":[{"content_id":"core:status/ward","version":1}],
     "payload":{"tone":"boon","message":"You draw the seeping energy into your body.",
       "outcomes":[{"type":"restore","resource":"energy","amount":6},{"type":"xp","amount":25},{"type":"apply_status","content_id":"core:status/ward","version":1}]}},
    {"content_id":"core:event/miasma","version":1,"schema_version":1,"kind":"world_event","name":"Miasma burst","description":"Trapped marsh gas erupts underfoot.","metadata":{"category":"hazard"},
     "dependencies":[{"content_id":"core:status/poison","version":1}],
     "payload":{"tone":"bane","message":"The ground gives way and choking miasma bursts around you!",
       "outcomes":[{"type":"damage","amount":2},{"type":"apply_status","content_id":"core:status/poison","version":1}]}},
    {"content_id":"core:event/clear_spring","version":1,"schema_version":1,"kind":"world_event","name":"Clear spring","description":"Cold, clean water and herbs growing at its edge.","metadata":{"category":"resource"},
     "dependencies":[{"content_id":"core:fresh_water","version":1},{"content_id":"core:herb","version":1}],
     "payload":{"tone":"boon","message":"You drink deeply and fill your flasks; herbs grow along the edge.",
       "outcomes":[{"type":"quench","amount":40},{"type":"grant_items","items":[{"content_id":"core:fresh_water","version":1,"quantity":2},{"content_id":"core:herb","version":1,"quantity":2}]}]}},

    {"content_id":"core:place/ancient_ruin","version":1,"schema_version":1,"kind":"location","name":"Ancient ruin","description":"Toppled pillars of a forgotten outpost. Its storeroom and inscription may still hold something.","metadata":{"category":"ruin"},
     "dependencies":[{"content_id":"core:event/ruin_cache","version":1},{"content_id":"core:event/ruin_inscription","version":1}],
     "payload":{"category":"ruin","visual":"ruin","spawn":{"biomes":["forest","meadow"],"per_10000":2,"priority":30},
       "discovery":{"mode":"visible"},
       "interactions":[{"id":"search","verb":"Search the storeroom","trigger":"interact","event":{"content_id":"core:event/ruin_cache","version":1}},
         {"id":"decipher","verb":"Read the inscription","trigger":"interact","after":"search","event":{"content_id":"core:event/ruin_inscription","version":1}}]}},
    {"content_id":"core:place/buried_shrine","version":1,"schema_version":1,"kind":"location","name":"Buried shrine","description":"A moss-covered altar half sunk in the earth. Offer to it, or rob it.","metadata":{"category":"shrine"},
     "dependencies":[{"content_id":"core:event/shrine_offering","version":1},{"content_id":"core:event/shrine_plunder","version":1}],
     "payload":{"category":"shrine","visual":"shrine","spawn":{"biomes":["forest"],"per_10000":2,"priority":40},
       "discovery":{"mode":"search","radius":2},
       "interactions":[{"id":"offer","verb":"Offer a herb","trigger":"interact","exclusive":true,"event":{"content_id":"core:event/shrine_offering","version":1}},
         {"id":"plunder","verb":"Plunder the altar","trigger":"interact","exclusive":true,"event":{"content_id":"core:event/shrine_plunder","version":1}}]}},
    {"content_id":"core:place/spirit_vein","version":1,"schema_version":1,"kind":"location","name":"Spirit vein","description":"A faint crack humming with energy, invisible to ordinary senses.","metadata":{"category":"anomaly"},
     "dependencies":[{"content_id":"core:event/spirit_vein","version":1},{"content_id":"core:skill/body_tempering","version":1}],
     "payload":{"category":"anomaly","visual":"vein","spawn":{"biomes":["forest","meadow"],"per_10000":1,"priority":20,"conditions":[{"type":"danger","min":1,"max":3}]},
       "discovery":{"mode":"hidden","radius":3,"conditions":[{"type":"any_of","conditions":[{"type":"perception"},{"type":"skill_known","content_id":"core:skill/body_tempering"},{"type":"stat","stat":"attack","min":9}]}]},
       "interactions":[{"id":"absorb","verb":"Absorb the energy","trigger":"interact","event":{"content_id":"core:event/spirit_vein","version":1}}]}},
    {"content_id":"core:place/miasma_vent","version":1,"schema_version":1,"kind":"location","name":"Miasma vent","description":"A sunken patch of ground that once burst with choking gas.","metadata":{"category":"hazard"},
     "dependencies":[{"content_id":"core:event/miasma","version":1}],
     "payload":{"category":"hazard","visual":"vent","spawn":{"biomes":["beach","forest"],"per_10000":5,"priority":50,"conditions":[{"type":"near_terrain","terrain":"water","radius":3}]},
       "discovery":{"mode":"proximity","radius":0},
       "interactions":[{"id":"burst","verb":"Step on the vent","trigger":"enter","event":{"content_id":"core:event/miasma","version":1}}]}},
    {"content_id":"core:place/clear_spring","version":1,"schema_version":1,"kind":"location","name":"Clear spring","description":"Cold water wells up between stones, with healing herbs along its edge.","metadata":{"category":"resource_site"},
     "dependencies":[{"content_id":"core:event/clear_spring","version":1}],
     "payload":{"category":"resource_site","visual":"spring_site","spawn":{"biomes":["meadow","beach"],"per_10000":2,"priority":60},
       "discovery":{"mode":"visible"},
       "interactions":[{"id":"draw","verb":"Drink and fill flasks","trigger":"interact","event":{"content_id":"core:event/clear_spring","version":1}}]}}
  ]
}
