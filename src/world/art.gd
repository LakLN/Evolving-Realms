extends RefCounted
## Presentation-only art registry built from assets/game/art_index.json (generated by
## tools/art/build_assets.py). Resolves content definitions to sprites with fallbacks;
## nothing here touches gameplay state. Missing art -> empty result -> code fallback.
const INDEX := "res://assets/game/art_index.json"
const ROOT := "res://assets/game/"
## Overlay layers in draw order: [atlas name, lower ground kinds, upper ground kinds].
const OVERLAYS := [["shallow", ["ocean"], ["forest", "beach", "meadow"]], ["sand", ["ocean"], ["forest", "beach", "meadow"]], ["forest", ["beach"], ["forest"]], ["grass", ["forest", "beach"], ["meadow"]]]
const GROUND_SOURCE := 0
const PROP_SOURCE := 1
const OVERLAY_SOURCE := 2 # + overlay index
const DECOR_SOURCE := 10
## Milestone 04 atlas lands: ground/prop kinds without source art yet are recoloured
## from an existing kind at load (presentation only; placeholder until an art batch).
const DERIVED_GROUND_SOURCE := 11
const DERIVED_PROP_SOURCE := 12
const DERIVED_GROUND := {"snow": "meadow", "taiga": "forest", "ice": "ocean", "ash": "meadow", "cinder": "beach", "lava": "ocean", "veil": "ocean", "road": "beach"}
const DERIVED_PROPS := {"pine": "tree", "basalt": "rock"}
## Milestone 05 Snow Mountain: code-painted PLACEHOLDER ground and edge overlays
## (src/world/snow_art.gd) until the requested art batch is approved and built.
const SnowArt = preload("res://src/world/snow_art.gd")
const SNOW_GROUND_SOURCE := 13
const SNOW_OVERLAY_SOURCE := 14 # + index into SnowArt.EDGES
const SNOW_S1_GROUND_SOURCE := 18
const SNOW_S1_PROP_SOURCE := 19
const SNOW_S1_INDEX := "res://assets/game/snow/snow_s1_index.json"
## Snow P0 production batch (tools/art/build_snow_p0.py), merged over S1 when present.
const SNOW_P0_GROUND_SOURCE := 20
const SNOW_P0_PROP_SOURCE := 21
const SNOW_P0_INDEX := "res://assets/game/snow/snow_p0_index.json"
const SNOW_ECONOMY_INDEX := "res://assets/game/snow/snow_economy_index.json"
const SNOW_FAUNA_INDEX := "res://assets/game/snow/snow_fauna_index.json"
## Snow terrain T1 (tools/art/build_snow_terrain.py): regional ground in the composed-area palette.
const SNOW_TERRAIN_INDEX := "res://assets/game/snow/snow_terrain_index.json"
const SNOW_TERRAIN_GROUND_SOURCE := 22
const SNOW_TERRAIN_PROP_SOURCE := 23
static var _shared: RefCounted

var index: Dictionary = {}
var px := 32
var tileset: TileSet
var ground: Dictionary = {} # biome -> [[Vector2i atlas coords, weight], ...]
var props: Dictionary = {} # "tree", "rock", "rock_<biome>" -> [[Vector2i, weight], ...]
var decor: Dictionary = {} # biome -> [[Vector2i, weight], ...]
var ground_sources: Dictionary = {} # derived ground kind -> TileSet source id
var prop_sources: Dictionary = {} # derived prop kind -> TileSet source id
## Every transition overlay in draw order: [lower kinds, upper kinds, TileSet source id].
var overlay_specs: Array = []
## Ground kinds painted as placeholders (not final art); reported by tests and docs.
var placeholder_kinds: Array = []
## Loaded Batch S1 index ({} when absent): approved Snow Mountain art.
var snow_s1: Dictionary = {}
var _textures: Dictionary = {}
var _frames: Dictionary = {}

static func shared() -> RefCounted:
	if _shared == null:
		_shared = load("res://src/world/art.gd").new()
	return _shared

func _init() -> void:
	var file := FileAccess.open(INDEX, FileAccess.READ)
	var parsed: Variant = JSON.parse_string(file.get_as_text()) if file != null else null
	if not parsed is Dictionary or int(parsed.get("version", 0)) != 1:
		push_warning("Art index missing or unsupported; using code-drawn fallback art")
		return
	index = parsed
	px = int(index.tile_px)
	_build_tileset()

func ready() -> bool:
	return tileset != null

func texture(relative: String) -> Texture2D:
	if not _textures.has(relative):
		_textures[relative] = load(ROOT + relative) if ResourceLoader.exists(ROOT + relative) else null
	return _textures[relative]

func _atlas(relative: String, region: int) -> TileSetAtlasSource:
	var source := TileSetAtlasSource.new()
	source.texture = texture(relative)
	source.texture_region_size = Vector2i(region, region)
	return source

func _build_tileset() -> void:
	var built := TileSet.new()
	built.tile_size = Vector2i(px, px)
	var ground_source := _atlas(index.ground.atlas, px)
	built.add_source(ground_source, GROUND_SOURCE)
	for biome in index.ground.biomes:
		ground[biome] = []
		for entry in index.ground.biomes[biome]:
			var coords := Vector2i(int(entry[0]), int(entry[1]))
			ground_source.create_tile(coords)
			ground[biome].append([coords, int(entry[2])])
	var prop_source := _atlas(index.props.atlas, int(index.props.cell))
	built.add_source(prop_source, PROP_SOURCE)
	for kind in index.props:
		if not index.props[kind] is Array:
			continue # "atlas", "cell"
		props[kind] = []
		for entry in index.props[kind]:
			var coords := Vector2i(int(entry[0]), 0)
			prop_source.create_tile(coords)
			props[kind].append([coords, int(entry[1])])
	for i in OVERLAYS.size():
		var source := _atlas(index.overlays[OVERLAYS[i][0]], px)
		built.add_source(source, OVERLAY_SOURCE + i)
		for mask in range(1, 256):
			source.create_tile(Vector2i(mask % 16, mask / 16))
	if index.has("decor"):
		var decor_source := _atlas(index.decor.atlas, px)
		built.add_source(decor_source, DECOR_SOURCE)
		for biome in index.decor:
			if not index.decor[biome] is Array:
				continue
			decor[biome] = []
			for entry in index.decor[biome]:
				var coords := Vector2i(int(entry[0]), 0)
				decor_source.create_tile(coords)
				decor[biome].append([coords, int(entry[1])])
	_derive(built)
	for i in OVERLAYS.size(): overlay_specs.append([OVERLAYS[i][1], OVERLAYS[i][2], OVERLAY_SOURCE + i])
	_paint_snow(built)
	tileset = built

func _paint_snow(built: TileSet) -> void:
	var columns := 0
	for kind in SnowArt.VARIANTS: columns = maxi(columns, int(SnowArt.VARIANTS[kind]))
	var image := Image.create(px * columns, px * SnowArt.VARIANTS.size(), false, Image.FORMAT_RGBA8)
	var groups: Array = []
	var row := 0
	for kind in SnowArt.VARIANTS:
		ground[kind] = []
		for variant in int(SnowArt.VARIANTS[kind]):
			image.blit_rect(SnowArt.paint(kind, variant, px), Rect2i(0, 0, px, px), Vector2i(variant, row) * px)
			ground[kind].append([Vector2i(variant, row), 6 if variant == 0 else 2])
		ground_sources[kind] = SNOW_GROUND_SOURCE
		placeholder_kinds.append(kind)
		groups.append(ground[kind])
		row += 1
	_add_atlas(built, image, px, SNOW_GROUND_SOURCE, groups)
	var approved := _load_snow_s1(built)
	approved.merge(_load_snow_index(built, SNOW_P0_INDEX, SNOW_P0_GROUND_SOURCE, SNOW_P0_PROP_SOURCE), true)
	approved.merge(_load_snow_index(built, SNOW_ECONOMY_INDEX, SNOW_P0_GROUND_SOURCE, SNOW_P0_PROP_SOURCE), true)
	approved.merge(_load_snow_index(built, SNOW_FAUNA_INDEX, SNOW_P0_GROUND_SOURCE, SNOW_P0_PROP_SOURCE), true)
	approved.merge(_load_snow_index(built, SNOW_TERRAIN_INDEX, SNOW_TERRAIN_GROUND_SOURCE, SNOW_TERRAIN_PROP_SOURCE), true)
	for i in SnowArt.EDGES.size():
		var upper: String = SnowArt.EDGES[i][0]
		var upper_image: Image = approved.get(upper, SnowArt.paint(upper, 0, px))
		var atlas := SnowArt.overlay_atlas(SnowArt.edge_pieces(upper_image, px, 500 + i), px)
		var source := TileSetAtlasSource.new()
		source.texture = ImageTexture.create_from_image(atlas)
		source.texture_region_size = Vector2i(px, px)
		built.add_source(source, SNOW_OVERLAY_SOURCE + i)
		for mask in range(1, 256): source.create_tile(Vector2i(mask % 16, mask / 16))
		overlay_specs.append([SnowArt.EDGES[i][1], [upper], SNOW_OVERLAY_SOURCE + i])

func _load_snow_s1(built: TileSet) -> Dictionary:
	## Approved Batch S1 art (tools/art/build_snow_s1.py) replaces placeholder kinds,
	## pines and snow-land rocks, and adds snow objects, places and the snow wolf.
	## Returns kind -> base tile image (upper textures for the edge overlays).
	return _load_snow_index(built, SNOW_S1_INDEX, SNOW_S1_GROUND_SOURCE, SNOW_S1_PROP_SOURCE)

func _load_snow_index(built: TileSet, path: String, ground_id: int, prop_id: int) -> Dictionary:
	## One snow art index: optional ground kinds/props on their own TileSet sources, plus
	## objects, places, characters, icons and mapping tables merged over earlier ones.
	var file := FileAccess.open(path, FileAccess.READ)
	var parsed: Variant = JSON.parse_string(file.get_as_text()) if file != null else null
	if not parsed is Dictionary or int(parsed.get("version", 0)) != 1 or int(parsed.get("tile_px", 0)) != px:
		return {}
	if path == SNOW_S1_INDEX: snow_s1 = parsed
	var bases := {}
	var ground_image := _image(parsed.ground.atlas) if parsed.has("ground") else null
	if ground_image != null:
		var groups: Array = []
		for kind in parsed.ground.kinds:
			ground[kind] = []
			for entry in parsed.ground.kinds[kind]:
				ground[kind].append([Vector2i(int(entry[0]), int(entry[1])), int(entry[2])])
			ground_sources[kind] = ground_id
			placeholder_kinds.erase(kind)
			groups.append(ground[kind])
			var first: Array = parsed.ground.kinds[kind][0]
			bases[kind] = ground_image.get_region(Rect2i(Vector2i(int(first[0]), int(first[1])) * px, Vector2i(px, px)))
		_add_atlas(built, ground_image, px, ground_id, groups)
	var source := _atlas(parsed.props.atlas, int(parsed.props.cell)) if parsed.has("props") else TileSetAtlasSource.new()
	if source.texture != null:
		built.add_source(source, prop_id)
		for kind in parsed.props:
			if not parsed.props[kind] is Array: continue
			props[kind] = []
			for entry in parsed.props[kind]:
				var coords := Vector2i(int(entry[0]), 0)
				if not source.has_tile(coords): source.create_tile(coords)
				props[kind].append([coords, int(entry[1])])
			prop_sources[kind] = prop_id
	for group in ["objects", "places", "characters", "icons"]:
		if not index.has(group): index[group] = {}
		index[group].merge(parsed.get(group, {}), true)
	var mapping: Dictionary = index.get("mapping", {})
	for group in parsed.get("mapping", {}):
		if not mapping.has(group): mapping[group] = {}
		for table in parsed.mapping[group]:
			var extra: Variant = parsed.mapping[group][table]
			if extra is Dictionary and mapping[group].get(table) is Dictionary:
				mapping[group][table].merge(extra, true)
			elif extra is Dictionary and not mapping[group].has(table):
				mapping[group][table] = extra.duplicate(true) # A table only an overlay index defines.
			elif extra is String and mapping[group] is Dictionary:
				mapping[group][table] = extra
	return bases

func ground_source(kind: String) -> int:
	return ground_sources.get(kind, GROUND_SOURCE)

func prop_source(kind: String) -> int:
	return prop_sources.get(kind, PROP_SOURCE)

func _derive(built: TileSet) -> void:
	var ground_image := _image(index.ground.atlas)
	var columns := 1
	for kind in DERIVED_GROUND: columns = maxi(columns, ground.get(DERIVED_GROUND[kind], []).size())
	if ground_image != null:
		var image := Image.create(px * columns, px * DERIVED_GROUND.size(), false, Image.FORMAT_RGBA8)
		var row := 0
		for kind in DERIVED_GROUND:
			ground[kind] = []
			for column in ground[DERIVED_GROUND[kind]].size():
				var entry: Array = ground[DERIVED_GROUND[kind]][column]
				_recolor(ground_image, Rect2i(entry[0] * px, Vector2i(px, px)), image, Vector2i(column, row) * px, kind)
				ground[kind].append([Vector2i(column, row), entry[1]])
			ground_sources[kind] = DERIVED_GROUND_SOURCE
			row += 1
		_add_atlas(built, image, px, DERIVED_GROUND_SOURCE, ground.keys().filter(func(k: String) -> bool: return ground_sources.has(k)).map(func(k: String) -> Array: return ground[k]))
	else:
		for kind in DERIVED_GROUND: ground[kind] = ground[DERIVED_GROUND[kind]]
	var cell := int(index.props.cell)
	var prop_image := _image(index.props.atlas)
	if prop_image != null:
		var count := 0
		for kind in DERIVED_PROPS: count += props.get(DERIVED_PROPS[kind], []).size()
		var image := Image.create(cell * maxi(1, count), cell, false, Image.FORMAT_RGBA8)
		var column := 0
		for kind in DERIVED_PROPS:
			props[kind] = []
			for entry in props.get(DERIVED_PROPS[kind], []):
				_recolor(prop_image, Rect2i(Vector2i(entry[0].x * cell, 0), Vector2i(cell, cell)), image, Vector2i(column * cell, 0), kind)
				props[kind].append([Vector2i(column, 0), entry[1]])
				column += 1
			prop_sources[kind] = DERIVED_PROP_SOURCE
		_add_atlas(built, image, cell, DERIVED_PROP_SOURCE, DERIVED_PROPS.keys().map(func(k: String) -> Array: return props[k]))
	else:
		for kind in DERIVED_PROPS: props[kind] = props.get(DERIVED_PROPS[kind], [])

func _image(relative: String) -> Image:
	var source := texture(relative)
	var image: Image = source.get_image() if source != null else null
	if image == null or image.is_empty():
		return null
	if image.is_compressed(): image.decompress()
	image.convert(Image.FORMAT_RGBA8)
	return image

static func _add_atlas(built: TileSet, image: Image, region: int, id: int, groups: Array) -> void:
	var source := TileSetAtlasSource.new()
	source.texture = ImageTexture.create_from_image(image)
	source.texture_region_size = Vector2i(region, region)
	built.add_source(source, id)
	for group in groups:
		for entry in group:
			if not source.has_tile(entry[0]): source.create_tile(entry[0])

static func _recolor(from: Image, rect: Rect2i, into: Image, at: Vector2i, kind: String) -> void:
	for y in rect.size.y:
		for x in rect.size.x:
			into.set_pixel(at.x + x, at.y + y, tint(kind, from.get_pixel(rect.position.x + x, rect.position.y + y)))

static func tint(kind: String, c: Color) -> Color:
	var l := c.get_luminance()
	match kind:
		"snow": return Color(0.80 + 0.2 * l, 0.84 + 0.16 * l, 0.90 + 0.1 * l, c.a)
		"taiga": return c.lerp(Color(0.86, 0.9, 0.95, c.a), 0.5)
		"ice": return Color(0.55 + 0.35 * l, 0.76 + 0.2 * l, 0.86 + 0.14 * l, c.a)
		"ash": return Color(0.17 + 0.3 * l, 0.16 + 0.28 * l, 0.16 + 0.27 * l, c.a)
		"cinder": return Color(0.32 + 0.5 * l, 0.12 + 0.2 * l, 0.07 + 0.08 * l, c.a)
		"lava": return Color(0.95, 0.22 + 0.6 * l, 0.04 + 0.16 * l, c.a)
		"veil": return Color(0.58 + 0.16 * l, 0.61 + 0.16 * l, 0.69 + 0.16 * l, c.a)
		"road": return Color(0.33 + 0.22 * l, 0.28 + 0.18 * l, 0.21 + 0.14 * l, c.a)
		"basalt": return Color(0.11 + 0.25 * l, 0.10 + 0.22 * l, 0.12 + 0.25 * l, c.a)
		"pine":
			if c.g > c.r + 0.03: # Foliage: dark blue-green with snow on lit needles.
				var needle := Color(0.10 + 0.25 * l, 0.24 + 0.3 * l, 0.25 + 0.3 * l, c.a)
				return needle.lerp(Color(0.93, 0.95, 0.98, c.a), 0.65) if l > 0.5 else needle
			return c
	return c

static func pick(choices: Array, roll: int) -> Vector2i:
	## Weighted choice from a stable per-tile roll (presentation only).
	var total := 0
	for choice in choices:
		total += choice[1]
	var value := roll % maxi(total, 1)
	for choice in choices:
		value -= choice[1]
		if value < 0:
			return choice[0]
	return choices[0][0]

static func tile_roll(tile: Vector2i, salt: int) -> int:
	var value := (tile.x * 73856093) ^ (tile.y * 19349663) ^ (salt * 83492791)
	value = ((value ^ (value >> 13)) * 1274126177) & 0x7fffffff
	return value ^ (value >> 16)

func frames(name: String) -> SpriteFrames:
	## Animations "<state>_<direction>" (idle, walk, attack, hit, death x down/left/right/up).
	if _frames.has(name):
		return _frames[name]
	var spec: Dictionary = index.get("characters", {}).get(name, {})
	var sheet := texture(spec.get("sheet", "")) if not spec.is_empty() else null
	if sheet == null:
		return null
	var result := SpriteFrames.new()
	result.remove_animation("default")
	var size := Vector2(spec.frame[0], spec.frame[1])
	for anim in spec.anims:
		result.add_animation(anim)
		var state: String = anim.get_slice("_", 0)
		result.set_animation_loop(anim, state in ["idle", "walk"])
		result.set_animation_speed(anim, {"idle": 2.0, "walk": 10.0, "attack": 14.0, "hit": 8.0, "death": 5.0}[state])
		for frame in spec.anims[anim]:
			var region := AtlasTexture.new()
			region.atlas = sheet
			region.region = Rect2(Vector2(int(frame) % int(spec.columns), int(frame) / int(spec.columns)) * size, size)
			result.add_frame(anim, region)
	_frames[name] = result
	return result

func anchor(name: String) -> Vector2:
	var spec: Dictionary = index.get("characters", {}).get(name, {})
	return Vector2(spec.anchor[0], spec.anchor[1]) if spec.has("anchor") else Vector2.ZERO

func creature_sheet(definition: Dictionary) -> String:
	## Exact content ID first (a native species keeps its look without restyling the
	## shared visual, e.g. the rime hare vs core rabbits), then the payload visual.
	var mapping: Dictionary = index.get("mapping", {})
	var exact: String = str(mapping.get("creatures_by_id", {}).get(definition.get("content_id", ""), ""))
	return exact if not exact.is_empty() else str(mapping.get("creatures", {}).get(definition.get("payload", {}).get("visual", ""), ""))

func object_sprite(definition: Dictionary, opened: bool) -> Texture2D:
	var map: Dictionary = index.get("mapping", {}).get("objects", {})
	var payload: Dictionary = definition.get("payload", {})
	var name: String = map.get("by_id", {}).get(definition.get("content_id", ""), map.get("by_visual", {}).get(payload.get("visual", ""), map.get("by_kind", {}).get(definition.get("kind", ""), "")))
	if opened:
		name = map.get("opened", {}).get(name, name)
	return _single("objects", name)

func place_sprite(definition: Dictionary) -> Texture2D:
	var map: Dictionary = index.get("mapping", {}).get("places", {})
	var payload: Dictionary = definition.get("payload", {})
	var name: String = map.get("by_id", {}).get(definition.get("content_id", ""), map.get("by_visual", {}).get(payload.get("visual", ""), map.get("by_category", {}).get(payload.get("category", ""), map.get("default", ""))))
	return _single("places", name)

func place_stage(definition: Dictionary, record: Dictionary) -> String:
	## A persistent site's visible stage from this Run's record: index
	## mapping.places.stages_by_id lists [when, sprite]; `when` is a resolved interaction
	## id or "state:<world_state>". The last satisfied entry wins; "" = base sprite.
	var stages: Array = index.get("mapping", {}).get("places", {}).get("stages_by_id", {}).get(definition.get("content_id", ""), [])
	var resolved: Dictionary = record.get("resolved", {})
	var result := ""
	for entry in stages:
		var when := str(entry[0])
		var got: bool = when.begins_with("got:") and not resolved.get(when.substr(4), {}).get("received", []).is_empty() # Only if it paid out.
		if resolved.has(when) or got or (when.begins_with("state:") and str(record.get("world_state", "")) == when.substr(6)):
			result = str(entry[1])
	return result

func stage_sprite(name: String) -> Texture2D:
	return _single("places", name)

func stage_pivot(name: String) -> Vector2:
	var pivot: Variant = index.get("places", {}).get(name, {}).get("pivot")
	return Vector2(pivot[0], pivot[1]) if pivot is Array and pivot.size() == 2 else Vector2(-1, -1)

func place_glow(stage: String) -> Color:
	## Lit stages (index places.<name>.glow) cast a warm halo; transparent otherwise.
	var glow: Variant = index.get("places", {}).get(stage, {}).get("glow") if not stage.is_empty() else null
	return Color(str(glow)) if glow is String else Color(0, 0, 0, 0)

func place_pivot(definition: Dictionary) -> Vector2:
	## Declared ground-contact point inside the place image, or (-1, -1) for the legacy
	## bottom-centred placement.
	var map: Dictionary = index.get("mapping", {}).get("places", {})
	var payload: Dictionary = definition.get("payload", {})
	var name: String = map.get("by_id", {}).get(definition.get("content_id", ""), map.get("by_visual", {}).get(payload.get("visual", ""), ""))
	var pivot: Variant = index.get("places", {}).get(name, {}).get("pivot")
	return Vector2(pivot[0], pivot[1]) if pivot is Array and pivot.size() == 2 else Vector2(-1, -1)

func item_icon(content_id: String, name: String, definition: Dictionary = {}) -> Texture2D:
	## Exact content ID, then equipment slot, skill book, then a keyword of the id
	## (namespace skipped) or name.
	var mapping: Dictionary = index.get("mapping", {})
	if mapping.get("item_icons_by_id", {}).has(content_id):
		var exact := icon(mapping.item_icons_by_id[content_id])
		if exact != null: return exact
	var payload: Dictionary = definition.get("payload", {})
	if payload.get("equipment") is Dictionary and mapping.get("slot_icons", {}).has(payload.equipment.get("slot", "")):
		return icon(mapping.slot_icons[payload.equipment.slot])
	if payload.has("skill_book") and mapping.has("book_icon"):
		return icon(mapping.book_icon)
	var key := (content_id.get_slice(":", content_id.get_slice_count(":") - 1) + " " + name).to_lower()
	var icons: Dictionary = mapping.get("item_icons", {})
	for word in icons:
		if key.contains(word):
			return icon(icons[word])
	return null

func icon(name: String) -> Texture2D:
	## UI icon by name, falling back to an object sprite of that name.
	var found := _single("icons", name)
	return found if found != null else _single("objects", name)

func status_icon(status: String) -> Texture2D:
	var key := status.to_lower()
	key = key.get_slice("/", key.get_slice_count("/") - 1)
	var icons: Dictionary = index.get("mapping", {}).get("status_icons", {})
	for word in icons:
		if key.contains(word):
			return icon(icons[word])
	return null

func _single(group: String, name: String) -> Texture2D:
	var entry: Dictionary = index.get(group, {}).get(name, {})
	return texture(entry.texture) if entry.has("texture") else null
